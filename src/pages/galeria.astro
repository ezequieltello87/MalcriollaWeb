// 2. Mapeamos usando rutasFotos correctamente
const fotos = rutasFotos.map(item => {
    if (typeof item === 'string') {
        return { src: `${base}${item}` };
    } else {
        return { src: `${base}${item.ruta}`, horizontal: item.horizontal };
    }
});
---

<GaleriaTemplate 
    titulo="Denim Sin Reglas 2024"
    audioSrc="/tu-tema-2024.mp3"
    anteriorUrl=""
    siguienteUrl="/galeria1"
    imagenes={fotos}
